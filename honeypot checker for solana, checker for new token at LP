
import { Connection, PublicKey } from "@solana/web3.js";

const RPC = "https://api.mainnet-beta.solana.com";

const connection = new Connection(RPC);
const SOL = "So11111111111111111111111111111111111111112";

async function checkToken(mint: string) {
  console.log("\nSCANNING:", mint);

  let risk = 0;
  const warnings: string[] = [];

  // 1. Token supply and decimals
  const supply = await connection.getTokenSupply(
    new PublicKey(mint)
  );

  const decimals = supply.value.decimals;

  console.log("Supply:", supply.value.uiAmountString);
  console.log("Decimals:", decimals);

  // 2. RugCheck security report
  try {
    const response = await fetch(
      `https://api.rugcheck.xyz/v1/tokens/${mint}/report`
    );

    if (response.ok) {
      const report: any = await response.json();

      console.log("RugCheck:", report.score);
      console.log("Risk flags:", report.risks);

      for (const item of report.risks || []) {
        if (item.level === "danger") {
          risk += 30;
          warnings.push(item.name);
        } else if (item.level === "warn") {
          risk += 10;
          warnings.push(item.name);
        }
      }
    } else {
      warnings.push("RugCheck unavailable");
      risk += 10;
    }
  } catch {
    warnings.push("RugCheck API error");
    risk += 10;
  }

  // 3. DexScreener LP check
  let pairs: any[] = [];

  try {
    const response = await fetch(
      `https://api.dexscreener.com/token-pairs/v1/solana/${mint}`
    );

    if (response.ok) {
      pairs = await response.json();

      for (const pair of pairs) {
        console.log("\nDEX:", pair.dexId);
        console.log("Liquidity:", pair.liquidity?.usd);
        console.log("Volume 24h:", pair.volume?.h24);
        console.log("Pair age:",
          new Date(pair.pairCreatedAt).toISOString()
        );
      }
    }
  } catch {
    warnings.push("DEX data unavailable");
  }

  const bestPair = pairs.sort(
    (a, b) =>
      (b.liquidity?.usd || 0) -
      (a.liquidity?.usd || 0)
  )[0];

  const liquidity = bestPair?.liquidity?.usd || 0;

  if (!bestPair || liquidity < 5000) {
    risk += 25;
    warnings.push("Low or missing liquidity");
  }

  // 4. Jupiter sell-route test
  try {
    const amount = 10 ** decimals;

    const url = new URL(
      "https://lite-api.jup.ag/swap/v1/quote"
    );

    url.searchParams.set("inputMint", mint);
    url.searchParams.set("outputMint", SOL);
    url.searchParams.set("amount", String(amount));
    url.searchParams.set("slippageBps", "500");

    const response = await fetch(url);

    if (response.ok) {
      const quote: any = await response.json();

      if (!quote.outAmount || quote.outAmount === "0") {
        risk += 40;
        warnings.push("No executable sell quote");
      } else {
        console.log("Sell route: AVAILABLE");
        console.log("Route impact:", quote.priceImpactPct);
      }
    } else {
      risk += 30;
      warnings.push("No Jupiter sell route");
    }
  } catch {
    risk += 20;
    warnings.push("Jupiter API error");
  }

  // 5. Final verdict
  risk = Math.min(risk, 100);

  console.log("\n========== RESULT ==========");

  console.log("Risk Score:", risk);

  if (risk >= 60) {
    console.log("DANGER - HIGH RISK");
  } else if (risk >= 30) {
    console.log("WARNING - CHECK CAREFULLY");
  } else {
    console.log("LOW FLAG COUNT - NOT GUARANTEED SAFE");
  }

  console.log("Warnings:", warnings);
}

const mint = process.argv[2];

if (!mint) {
  console.log("Usage: npx tsx scanner.ts TOKEN_MINT");
} else {
  checkToken(mint).catch(console.error);
}
